%% GUAC (guacsec/guac v1.1.0) - generated from guac.graphspec.yaml; keep in sync.
%% 29 node types (12 software-tree, 17 evidence), 56 relationship types.
%% GUAC quirk: evidence (attestations) are NODES carrying their own provenance
%% (origin, collector, documentRef); subject links run software -> evidence,
%% object links run evidence -> software. "?" marks optional properties.
%% Cardinalities are UML: label near a class = instances of that class per
%% instance of the other end (e.g. each IsDependency has exactly 1 subject
%% PackageVersion, and each PackageVersion has many IsDependency attestations).
  class PackageType {
    +String type
  }
  class PackageNamespace {
    +String type
    +String namespace
  }
  class PackageName {
    +String type
    +String namespace
    +String name
  }
  class PackageVersion {
    +String purl
    +String version
    +List~String~ qualifiers
    +String subpath
  }
  class SourceType {
    +String type
  }
  class SourceNamespace {
    +String type
    +String namespace
  }
  class SourceName {
    +String type
    +String namespace
    +String name
    +String? tag
    +String? commit
  }
  class Artifact {
    +String algorithm
    +String digest
  }
  class Builder {
    +String uri
  }
  class VulnerabilityType {
    +String type
  }
  class VulnerabilityID {
    +String type
    +String vulnerabilityId
  }
  class License {
    +String name
    +String? inline
    +String listVersion
  }
  class IsDependency {
    +String dependencyType
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class IsOccurrence {
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class HasSourceAt {
    +Datetime knownSince
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class HashEqual {
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class PkgEqual {
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class VulnEqual {
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class HasSBOM {
    +String uri
    +String algorithm
    +String digest
    +String downloadLocation
    +Datetime knownSince
    +String origin
    +String collector
    +String documentRef
  }
  class HasSLSA {
    +String buildType
    +String slsaVersion
    +Datetime? startedOn
    +Datetime? finishedOn
    +List~String~ slsaPredicates
    +String origin
    +String collector
    +String documentRef
  }
  class HasMetadata {
    +String key
    +String value
    +Datetime timestamp
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class PointOfContact {
    +String email
    +String info
    +Datetime since
    +String justification
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyVuln {
    +Datetime timeScanned
    +String dbUri
    +String dbVersion
    +String scannerUri
    +String scannerVersion
    +String origin
    +String collector
    +String documentRef
  }
  class VulnerabilityMetadata {
    +String scoreType
    +Float scoreValue
    +Datetime timestamp
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyVEXStatement {
    +String status
    +String vexJustification
    +String statement
    +String statusNotes
    +Datetime knownSince
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyGood {
    +String justification
    +Datetime knownSince
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyBad {
    +String justification
    +Datetime knownSince
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyLegal {
    +String declaredLicense
    +String discoveredLicense
    +String attribution
    +String justification
    +Datetime timeScanned
    +String origin
    +String collector
    +String documentRef
  }
  class CertifyScorecard {
    +Float aggregateScore
    +List~String~ checks
    +Datetime timeScanned
    +String scorecardVersion
    +String scorecardCommit
    +String origin
    +String collector
    +String documentRef
  }

